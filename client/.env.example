# Copy this file to .env and fill in real values. Restart `npm run dev` after changes.

# Address of the API, ending in /api (on Vercel: https://<your-render-app>.onrender.com/api)
# On Vercel, a change here needs a Redeploy (Vite puts these values in at build time)
VITE_API_URL=http://localhost:5000/api

# Pricing page
VITE_PRICE_TEXT=Price coming soon
# IPP-1704: price of the "One language" plan
VITE_PRICE_ONE_TEXT=Ask for price
VITE_CONTACT_EMAIL=arsalmustafa62@gmail.com
