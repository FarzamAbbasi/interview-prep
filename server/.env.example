# Copy this file to .env and fill in real values. Never commit .env.

# ---- App ----
PORT=5000
NODE_ENV=development          # production on Render
CLIENT_URL=http://localhost:5173   # the website address (used for CORS and email links)

# ---- Database (MongoDB Atlas) ----
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/interview-prep?retryWrites=true&w=majority

# ---- Login tokens ----
JWT_SECRET=change-me-to-a-long-random-string-64-characters-or-more
JWT_EXPIRES_IN=7d

# ---- First admin (created by `npm run seed` if this email does not exist) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Email ----
# Option A (Render / live): Brevo HTTP API. Render's free plan blocks SMTP ports.
#   BREVO_API_KEY set -> Brevo is used and the SMTP_* lines are ignored.
BREVO_API_KEY=
EMAIL_FROM=your-verified-sender@gmail.com   # must be a verified sender in Brevo
EMAIL_FROM_NAME=Interview Prep Portal

# Option B (local): Gmail SMTP with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
